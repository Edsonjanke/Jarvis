        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute[name.name='tag'] > Literal[value!=/^(?:sys|ok|info|warn|err)$/]",
        "message": "<TerminalLine> tag must be one of 'sys' | 'ok' | 'info' | 'warn' | 'err'."
