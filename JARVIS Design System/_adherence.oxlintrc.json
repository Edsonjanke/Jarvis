{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/answer/**",
              "components/chrome/**",
              "components/controls/**",
              "components/hud/**",
              "components/listing/**",
              "components/status/**",
              "design_handoff_jarvis_console_v2/components/hud/**",
              "design_handoff_jarvis_console_v2/ui_kits/jarvis-console/**",
              "ui_kits/jarvis-console/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cascadia Code|Cascadia Mono|Source Sans 3))/i]",
        "message": "Font not provided by the design system. Available: Cascadia Code, Cascadia Mono, Source Sans 3."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|label|children|style|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: level, label, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:crit|warn|info)$/]",
        "message": "<Alert> level must be one of 'crit' | 'warn' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AnswerBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|meta|metaTitle|body|truncated|children|style|key|ref|className|style|children)$/]",
        "message": "<AnswerBlock> doesn't accept that prop. Declared props: kind, meta, metaTitle, body, truncated, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AskField'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|value|onChange|onSubmit|placeholder|hint|style|key|ref|className|style|children)$/]",
        "message": "<AskField> doesn't accept that prop. Declared props: mode, value, onChange, onSubmit, placeholder, hint, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BrainRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|pressed|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<BrainRow> doesn't accept that prop. Declared props: name, note, pressed, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|pressed|disabled|title|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: size, pressed, disabled, title, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:key|ghost)$/]",
        "message": "<Button> size must be one of 'key' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Cite'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Cite> doesn't accept that prop. Declared props: type, title, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|count|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, count, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FactRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:when|text|onForget|style|key|ref|className|style|children)$/]",
        "message": "<FactRow> doesn't accept that prop. Declared props: when, text, onForget, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HudFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|right|foot|children|style|key|ref|className|style|children)$/]",
        "message": "<HudFrame> doesn't accept that prop. Declared props: label, right, foot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaGrid'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|style|key|ref|className|style|children)$/]",
        "message": "<MetaGrid> doesn't accept that prop. Declared props: rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|display|tone|segmented|style|key|ref|className|style|children)$/]",
        "message": "<Meter> doesn't accept that prop. Declared props: label, value, display, tone, segmented, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Meter'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|warn|crit|muted)$/]",
        "message": "<Meter> tone must be one of 'accent' | 'warn' | 'crit' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OpenLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|title|style|key|ref|className|style|children)$/]",
        "message": "<OpenLink> doesn't accept that prop. Declared props: href, children, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:side|scroll|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: side, scroll, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:left|right|free)$/]",
        "message": "<Panel> side must be one of 'left' | 'right' | 'free'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelHead'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|rule|style|key|ref|className|style|children)$/]",
        "message": "<PanelHead> doesn't accept that prop. Declared props: label, children, rule, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PanelNote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<PanelNote> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RadialGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|size|label|caption|style|key|ref|className|style|children)$/]",
        "message": "<RadialGauge> doesn't accept that prop. Declared props: value, size, label, caption, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reactor'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|state|level|tilt|style|key|ref|className|style|children)$/]",
        "message": "<Reactor> doesn't accept that prop. Declared props: size, state, level, tilt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reactor'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|thinking|speaking)$/]",
        "message": "<Reactor> state must be one of 'idle' | 'listening' | 'thinking' | 'speaking'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReactorDial'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|level|sub|size|style|key|ref|className|style|children)$/]",
        "message": "<ReactorDial> doesn't accept that prop. Declared props: state, level, sub, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReactorDial'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|thinking|speaking)$/]",
        "message": "<ReactorDial> state must be one of 'idle' | 'listening' | 'thinking' | 'speaking'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|where|snippet|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ResultRow> doesn't accept that prop. Declared props: type, title, where, snippet, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Row'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|tail|dir|step|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Row> doesn't accept that prop. Declared props: type, label, tail, dir, step, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|placeholder|style|key|ref|className|style|children)$/]",
        "message": "<SearchInput> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatList'] > JSXAttribute > JSXIdentifier[name!=/^(?:rows|style|key|ref|className|style|children)$/]",
        "message": "<StatList> doesn't accept that prop. Declared props: rows, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|colour|size|style|key|ref|className|style|children)$/]",
        "message": "<Swatch> doesn't accept that prop. Declared props: type, colour, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatch'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:client|project|meeting|invoice|person|note|reference|other)$/]",
        "message": "<Swatch> type must be one of 'client' | 'project' | 'meeting' | 'invoice' | 'person' | 'note' | 'reference' | 'other'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TerminalLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:at|tag|text|key|ref|className|style|children)$/]",
        "message": "<TerminalLine> doesn't accept that prop. Declared props: at, tag, text."
      },
