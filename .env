# =============================================================================
#  ⚠  ESTE ARQUIVO ESTÁ COMITADO NUM REPOSITÓRIO PÚBLICO, POR DECISÃO EXPLÍCITA.
#
#  A chave abaixo deve ser considerada COMPROMETIDA a partir do primeiro push.
#  Apagar este arquivo depois NÃO a remove do histórico do git.
#
#  ANTES DE CONSIDERAR O PROJETO PRONTO:
#    1. Rotacionar a chave em elevenlabs.io -> Profile -> API Key
#    2. Reescrever o histórico (git filter-repo) ou recriar o repositório
#    3. Voltar a linha ".env" para o .gitignore
# =============================================================================
# JARVIS secrets. Never reaches the browser — the server holds them.

# ---------------------------------------------------------------------------
# THE SWITCH. Read in exactly one file: agent/data.py
#   1 = invented fixtures, safe to screen-record   (default)
#   0 = your actual folders, listed in JARVIS_VAULTS
# ---------------------------------------------------------------------------
JARVIS_DEMO=0

# Real folders to index, read-only, recursive. Semicolon-separated.
# Ignored entirely while JARVIS_DEMO=1.
#
# E:\Orçamento saiu daqui a pedido do Edson: são 30 desenhos técnicos de RFQ,
# sem links entre si, todos do mesmo tipo — o grafo virava poeira de pontos
# idênticos. A pasta continua intacta no disco; só não é mais indexada.
JARVIS_VAULTS=E:\Jarvis\data\Cofre

# ---------------------------------------------------------------------------
# Language JARVIS thinks, writes and speaks in.
# ---------------------------------------------------------------------------
JARVIS_LANG=pt-BR

# ---------------------------------------------------------------------------
# LLM backend. Read in agent/llm.py.
#   subscription = drives the Claude Code CLI on Edson's Max plan (no API key)
#   api          = Anthropic API directly (needs ANTHROPIC_API_KEY)
#   off          = no model; keyword scoring only, with a visible badge
# ---------------------------------------------------------------------------
JARVIS_LLM=subscription
CLAUDE_CLI=C:\Users\Edson\.local\bin\claude.exe
CLAUDE_CLI_MODEL=claude-sonnet-4-6

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Voice. Free tier: 10,000 characters/month — agent/voice.py enforces a budget.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=dc4ca55e0123ead76c2c920be3cc339a39013a75cfcc94695a4cd9a5b198c3a7
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
ELEVENLABS_VOICE_NAME=Daniel
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
ELEVENLABS_MONTHLY_CHARS=10000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
