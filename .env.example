# Copy to .env and fill in. .env is gitignored and ACL-locked to your user.
# Nothing in here is ever sent to the browser.

# ---------------------------------------------------------------------------
# THE SWITCH. Read in exactly one file: agent/data.py
#   1 = invented fixtures, safe to screen-record   (default)
#   0 = your actual folders, listed in JARVIS_VAULTS
# ---------------------------------------------------------------------------
JARVIS_DEMO=1

# Real folders to index, read-only, recursive. Semicolon-separated.
# Ignored entirely while JARVIS_DEMO=1.
# JARVIS_VAULTS=E:\Notes;C:\Users\Edson\Documents\Clients

# ---------------------------------------------------------------------------
# The model. There is NO Anthropic API key here and nothing to pay per token:
# JARVIS runs on the Claude subscription already signed in on this machine, by
# driving the Claude Code CLI. If `claude auth status` says you are logged in,
# JARVIS can think.
#
# A concrete model id, not an alias — 'opus' and 'sonnet' move between releases
# and a silent move throws away the prompt cache. Sonnet is faster and lighter
# on the usage window; Opus is better at citing the right note.
# ---------------------------------------------------------------------------
JARVIS_LLM=subscription
CLAUDE_CLI_MODEL=claude-sonnet-4-6

# Where claude.exe lives. Leave empty and JARVIS finds it on PATH — which is
# usually right, and is what happens anyway if this points at nothing.
CLAUDE_CLI=

# The language answers come back in, e.g. pt-BR. Leave empty to follow the
# language of each question; set it if you want the briefing in your own
# language, since a briefing has no question to take a cue from.
JARVIS_LANG=

# ---------------------------------------------------------------------------
# Keys. Server-side only. Voice, from step 4 onwards.
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
